{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/next"],
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded"
    },
    "globals": ["Bun"]
  },
  "files": {
    "includes": ["packages/**", "apps/**", "e2e/**", "*.ts"]
  },
  "overrides": [
    {
      "includes": ["e2e/pre-commit/clone.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noEmptyPattern": "off"
          }
        }
      }
    }
  ]
}
